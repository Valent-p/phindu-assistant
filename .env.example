# ──────────────────────────────────────────────
# Phindu Assistant — environment configuration
# Copy this file to ".env" and fill in your values.
# Never commit ".env" to version control.
# ──────────────────────────────────────────────

APP_NAME="Phindu Assistant"
DEBUG=true

# SQLAlchemy async database URL
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///phindudb.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/phindudb

# JWT — generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-secure-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
